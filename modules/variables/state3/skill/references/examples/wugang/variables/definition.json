  "rules": [],
  "functions": {
    "isOngoing": {
      "reads": [
        [
          "docket",
          "clock"
        ],
        [
          "docket",
          "verdict"
        ]
      ],
      "description": "案件尚未结束且仍在时限内。"
    },
    "clampAdvance": {
      "reads": [
        [
          "docket",
          "clock"
        ]
      ],
      "description": "推进到截止时刻为止，返回实际经过分钟数。"
    },
    "clockSane": {
      "reads": [
        [
          "docket",
          "clock"
        ]
      ],
      "description": "时钟保持在本案规定的审理期限内。"
    },
    "verdictLabel": {
      "reads": [],
      "description": "结局的中文名称。"
    },
    "canDiscover": {
      "reads": [
        [
          "docket",
          "exhibits"
        ]
      ],
      "description": "只能首次取得尚未入册的证物。"
    },
    "exhibitUsable": {
      "reads": [
        [
          "docket",
          "exhibits"
        ]
      ],
      "description": "证物已取得、保管链合法且没有污染或销毁。"
    },
    "isUninspected": {
      "reads": [
        [
          "docket",
          "exhibits"
        ]
      ],
      "description": "证物尚未检验。"
    },
    "isNotSealed": {
      "reads": [
        [
          "docket",
          "exhibits"
        ]
      ],
      "description": "证物尚未封存。"
    },
    "canTransfer": {
      "reads": [
        [
          "docket",
          "exhibits"
        ],
        [
          "docket",
          "people"
        ]
      ],
      "description": "只能转交已取得且未封存、未销毁的证物；接收人必须存在且不同于当前保管人。"
    },
    "setExhibitState": {
      "reads": [
        [
          "docket",
          "exhibits"
        ]
      ],
      "description": "执行取证、转交、封存或检验；已有的断链和污染记录不会因登记或封存消失。"
    },
    "notTestified": {
      "reads": [
        [
          "docket",
          "people"
        ]
      ],
      "description": "只能录取尚未正式作证的涉案人员或见证人的证言。"
    },
    "addClaim": {
      "reads": [
        [
          "docket",
          "people"
        ],
        [
          "docket",
          "claims"
        ]
      ],
      "description": "把本次证言原文入册；口供只是说话者的陈述，不是程序确认的真相。"
    },
    "caseReadyToAccuse": {
      "reads": [
        [
          "docket",
          "exhibits"
        ]
      ],
      "description": "举证清单必须至少包含两件不同的有效证物，且其中至少一件检验吻合。"
    },
    "makeVerdict": {
      "reads": [
        [
          "docket",
          "exhibits"
        ]
      ],
      "description": "只依据本次提交的有效举证与指控对象判定结局。"
    },
    "leadOneReady": {
      "reads": [
        [
          "docket",
          "exhibits"
        ]
      ],
      "description": "相应证物获得了有效的吻合检验结果。"
    },
    "leadTwoReady": {
      "reads": [
        [
          "docket",
          "exhibits"
        ]
      ],
      "description": "相应证物获得了有效的吻合检验结果。"
    },
    "leadThreeReady": {
      "reads": [
        [
          "docket",
          "exhibits"
        ]
      ],
      "description": "相应证物获得了有效的吻合检验结果。"
    },
    "openLead": {
      "reads": [
        [
          "docket",
          "leads"
        ]
      ],
      "description": "首次获得有效检验结果后公开相应线索。"
    }
  },
  "actions": [
    {
      "id": "advance",
      "title": "推进时间",
      "description": "按玩家明确给出的分钟数推进审理时钟，最多推进到截止。到点未结案则收卷，后续实质动作不能继续。",
      "stages": [
        "before"
      ],
      "parameters": {
        "type": "object",
        "required": [
          "minutes"
        ],
        "properties": {
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 240,
            "description": "玩家明确要求推进的分钟数；超过剩余时间时只推进到截止。"
          }
        },
        "additionalProperties": false
      },
      "requires": {
        "call": "isOngoing",
        "args": []
      },
      "conversions": [],
      "effects": [
        {
          "path": [
            "docket",
            "clock",
            "minute"
          ],
          "value": {
            "op": "add",
            "args": [
              {
                "get": [
                  "docket",
                  "clock",
                  "minute"
                ]
              },
              {
                "call": "clampAdvance",
                "args": [
                  {
                    "param": [
                      "minutes"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "discover",
      "title": "取证",
      "description": "首次取得目录中的证物并交书记员保管；已经取得的证物不能重新登记来清除污染或断链。",
      "stages": [
        "before"
      ],
      "parameters": {
        "type": "object",
        "required": [
          "exhibitId"
        ],
        "properties": {
          "exhibitId": {
            "type": "string",
            "enum": [
              "EX-01",
              "EX-02",
              "EX-03",
              "EX-04",
              "EX-05"
            ]
          }
        },
        "additionalProperties": false
      },
      "requires": {
        "op": "and",
        "args": [
          {
            "call": "isOngoing",
            "args": []
          },
          {
            "call": "canDiscover",
            "args": [
              {
                "param": [
                  "exhibitId"
                ]
              }
            ]
          }
        ]
      },
      "conversions": [],
      "effects": [
        {
          "path": [
            "docket",
            "exhibits"
          ],
          "value": {
            "call": "setExhibitState",
            "args": [
              {
                "param": [
                  "exhibitId"
                ]
              },
              {
                "literal": "discover"
              },
              {
                "literal": null
              }
            ]
          }
        }
      ]
    },
    {
