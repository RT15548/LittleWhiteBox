  "access": [
    {
      "path": [
        "docket",
        "clock"
      ],
      "direct": false,
      "description": "已审分钟数与截止分钟数。",
      "update": "只有玩家明确要求等待、推进时间或给出耗时才提交 advance；不为每次对话自动扣时间。"
    },
    {
      "path": [
        "docket",
        "exhibits"
      ],
      "direct": false,
      "description": "固定证物目录；custodian 为空表示尚未取得，首次取证后交给书记员。",
      "update": "只提交玩家本轮明确要求且尚未结算的动作；询问规则、假设行动或复述既成结果不提交。按证物编号或名称映射取证、转交、封存、检验；复合请求按明确顺序提交。"
    },
    {
      "path": [
        "docket",
        "claims"
      ],
      "direct": false,
      "description": "已录入的证言，键为证言编号。",
      "update": "只提交玩家本轮明确要求且尚未结算的动作；询问规则、假设行动或复述既成结果不提交。玩家要求某人正式作证时提交 testify；普通交谈不自动录证言。"
    },
    {
      "path": [
        "docket",
        "leads"
      ],
      "direct": false,
      "description": "只有已点出的线索才能在正文里明确说出。"
    },
    {
      "path": [
        "docket",
        "verdict"
      ],
      "direct": false,
      "description": "程序给出的审理结果；结案后仅可更新人物配合度。",
      "update": "只提交玩家本轮明确要求且尚未结算的动作；询问规则、假设行动或复述既成结果不提交。正式指控须给出明确对象与证物清单；主动选择不指控结案时才提交 close_case。"
    },
    {
      "path": [
        "docket",
        "people",
        "suspect_a",
        "trust"
      ],
      "direct": true,
      "stages": [
        "after"
      ],
      "description": "祁修远的叙事配合度；影响态度描写，不改变证言或指控结论。",
      "update": "仅在正文中的问话、安抚或施压确实改变祁修远的态度时更新；闲聊、假设或未发生的许诺不改变。"
    },
    {
      "path": [
        "docket",
        "people",
        "suspect_b",
        "trust"
      ],
      "direct": true,
      "stages": [
        "after"
      ],
      "description": "罗阿九的叙事配合度；影响态度描写，不改变证言或指控结论。",
      "update": "仅在正文中的问话、安抚或施压确实改变罗阿九的态度时更新；闲聊、假设或未发生的许诺不改变。"
    },
    {
      "path": [
        "docket",
        "people",
        "suspect_c",
        "trust"
      ],
