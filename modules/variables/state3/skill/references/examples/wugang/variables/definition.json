{
  "format": 1,
  "name": "雾港证物审理",
  "updates": [
    "before",
    "after"
  ],
  "schema": {
    "type": "object",
    "required": [
      "docket"
    ],
    "properties": {
      "docket": {
        "type": "object",
        "required": [
          "clock",
          "exhibits",
          "people",
          "claims",
          "leads",
          "verdict"
        ],
        "properties": {
          "clock": {
            "type": "object",
            "description": "已审分钟数与截止分钟数。",
            "required": [
              "minute",
              "limit"
            ],
            "properties": {
              "minute": {
                "type": "integer",
                "description": "已审分钟，0 到 480。",
                "minimum": 0,
                "maximum": 480
              },
              "limit": {
                "type": "integer",
                "description": "截止分钟，固定 480。",
                "minimum": 480,
                "maximum": 480
              }
            }
          },
          "exhibits": {
            "type": "object",
            "description": "固定证物目录；custodian 为空表示尚未取得，首次取证后交给书记员。",
            "required": [
              "EX-01",
              "EX-02",
              "EX-03",
              "EX-04",
              "EX-05"
            ],
            "properties": {
              "EX-01": {
                "$ref": "#/$defs/exhibit"
              },
              "EX-02": {
                "$ref": "#/$defs/exhibit"
              },
              "EX-03": {
                "$ref": "#/$defs/exhibit"
              },
              "EX-04": {
                "$ref": "#/$defs/exhibit"
              },
              "EX-05": {
                "$ref": "#/$defs/exhibit"
              }
            },
            "additionalProperties": false
          },
          "people": {
            "type": "object",
            "description": "涉案人员及其配合度。",
            "required": [
              "suspect_a",
              "suspect_b",
              "suspect_c",
              "witness",
              "clerk"
            ],
            "properties": {
              "suspect_a": {
                "$ref": "#/$defs/person"
              },
              "suspect_b": {
                "$ref": "#/$defs/person"
              },
              "suspect_c": {
                "$ref": "#/$defs/person"
              },
              "witness": {
                "$ref": "#/$defs/person"
              },
              "clerk": {
                "$ref": "#/$defs/person"
              }
            },
            "additionalProperties": false
          },
          "claims": {
            "type": "object",
            "description": "已录入的证言，键为证言编号。",
            "additionalProperties": {
              "$ref": "#/$defs/claim"
            }
          },
          "leads": {
            "type": "object",
            "description": "只有已点出的线索才能在正文里明确说出。",
            "required": [
              "L-01",
              "L-02",
              "L-03"
            ],
            "properties": {
              "L-01": {
                "$ref": "#/$defs/lead"
              },
              "L-02": {
                "$ref": "#/$defs/lead"
              },
              "L-03": {
                "$ref": "#/$defs/lead"
              }
            },
            "additionalProperties": false
          },
          "verdict": {
            "type": "object",
            "description": "程序给出的审理结果；结案后仅可更新人物配合度。",
            "required": [
              "status",
              "label",
              "accused",
              "evidenceUsed",
              "reason"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "ongoing",
                  "right_accuse",
                  "wrong_accuse",
                  "no_accuse",
                  "timeout"
                ]
              },
              "label": {
                "type": "string"
              },
              "accused": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidenceUsed": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "EX-01",
                    "EX-02",
                    "EX-03",
                    "EX-04",
                    "EX-05"
                  ]
                }
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "$defs": {
      "exhibit": {
        "type": "object",
        "required": [
          "id",
          "name",
          "source",
          "custodian",
          "authenticity",
          "contamination",
          "legalChain",
          "sealed",
          "destroyed",
          "inspected",
          "tested",
          "testLabel"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "custodian": {
            "type": "string",
            "enum": [
              "",
              "clerk",
              "witness",
              "suspect_a",
              "suspect_b",
              "suspect_c"
            ]
          },
          "authenticity": {
            "type": "string",
            "enum": [
              "unknown",
              "genuine",
              "forged"
            ]
          },
          "contamination": {
            "type": "string",
            "enum": [
              "clean",
              "tainted",
              "destroyed"
            ]
          },
          "legalChain": {
            "type": "boolean"
          },
          "sealed": {
            "type": "boolean"
          },
          "destroyed": {
            "type": "boolean"
          },
          "inspected": {
            "type": "boolean"
          },
          "tested": {
            "type": "string",
            "enum": [
              "none",
              "match",
              "mismatch"
            ]
          },
          "testLabel": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "person": {
        "type": "object",
        "required": [
          "name",
          "role",
          "trust",
          "testified"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "trust": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "testified": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "claim": {
        "type": "object",
        "required": [
          "id",
          "speaker",
          "topic",
          "stance",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "stance": {
            "type": "string",
            "description": "证言明确指认的人物代号；空字符串表示未指认具体对象。"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "lead": {
        "type": "object",
        "required": [
          "id",
          "title",
          "opened"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "opened": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
